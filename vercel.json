{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app.py"
    }
  ],
  "functions": {
    "backend/app.py": {
      "maxDuration": 30,
      "runtime": "python3.12"
    }
  }
}
